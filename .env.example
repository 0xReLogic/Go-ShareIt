# ShareIt Environment Configuration

# Encryption Key (REQUIRED - must be exactly 32 characters)
# Generate a secure key using:
# - PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# - Linux/Mac: openssl rand -base64 32 | cut -c1-32
SHAREIT_ENCRYPTION_KEY=your-32-character-secret-key-here
